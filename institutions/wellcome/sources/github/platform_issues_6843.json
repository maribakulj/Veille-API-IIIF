s://api.github.com/users/kenoir/gists{/gist_id}","starred_url":"https://api.github.com/users/kenoir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kenoir/subscriptions","organizations_url":"https://api.github.com/users/kenoir/orgs","repos_url":"https://api.github.com/users/kenoir/repos","events_url":"https://api.github.com/users/kenoir/events{/privacy}","received_events_url":"https://api.github.com/users/kenoir/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2026-11-02T08:20:00Z","updated_at":"2026-11-02T12:52:51Z","closed_at":"2026-11-02T12:52:51Z","assignee":{"login":"kenoir","id":953792,"node_id":"MDQ6VXNlcjk1Mzc5Mg==","avatar_url":"https://avatars.githubusercontent.com/u/953792?v=4","gravatar_id":"","url":"https://api.github.com/users/kenoir","html_url":"https://github.com/kenoir","followers_url":"https://api.github.com/users/kenoir/followers","following_url":"https://api.github.com/users/kenoir/following{/other_user}","gists_url":"https://api.github.com/users/kenoir/gists{/gist_id}","starred_url":"https://api.github.com/users/kenoir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kenoir/subscriptions","organizations_url":"https://api.github.com/users/kenoir/orgs","repos_url":"https://api.github.com/users/kenoir/repos","events_url":"https://api.github.com/users/kenoir/events{/privacy}","received_events_url":"https://api.github.com/users/kenoir/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Short bot bursts are setting off the iiif 5xx alarms. Two WAF changes would stop them, and the evidence for both is in.\n\n## Bursts of direct navigations\n\nOn 1 Nov, 10k to 12k addresses sent one Mac Chrome user agent at resized `/image/.../full/N,/` widths with no Referer, each burst lasting about two minutes (00:05, 14:00, 15:40, 15:50 UTC). DLCS answered with 504s: 8,129 and 9,550 5xx in the worst hours, and some reader requests failed with them. The same pattern hit `/thumbs/` at 14:57 on 29 Oct and 03:09 on 1 Nov. Samples from 29 Oct show `Sec-Fetch-Dest: document`, `Sec-Fetch-Site: none` and zh-CN: the client opens image URLs as pages, which is why `image-browser-no-referer-resized` (it exempts any request with `Sec-Fetch-Dest`) lets them through.\n\n- [ ] Block `/thumbs/` and resized `/image/.../full/N,/` requests with `Sec-Fetch-Dest: document`, `Sec-Fetch-Site: none` and no Referer. Readers load these inside pages. In samples from 12:10 to 15:10 UTC on 29 Oct, every such request to `/thumbs/` was this fleet.\n- [ ] Count the same on `/image/.../full/`, where people opening shared links look alike.\n\n## Preview botnet\n\n- [ ] Move `ja4-desktop-chrome-ios-ua` (wellcomecollection/platform-infrastructure#605) from count to block. It counted 94k to 224k a day from 30 Oct to 1 Nov, and every logged match is a desktop-Chrome TLS fingerprint under an iPhone user agent, which no real iPhone can produce.\n\nNeither rule needs a rate-based slot; the ACL has used all 10.\n","closed_by":{"login":"kenoir","id":953792,"node_id":"MDQ6VXNlcjk1Mzc5Mg==","avatar_url":"https://avatars.githubusercontent.com/u/953792?v=4","gravatar_id":"","url":"https://api.github.com/users/kenoir","html_url":"https://github.com/kenoir","followers_url":"https://api.github.com/users/kenoir/followers","following_url":"https://api.github.com/users/kenoir/following{/other_user}","gists_url":"https://api.github.com/users/kenoir/gists{/gist_id}","starred_url":"https://api.github.com/users/kenoir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kenoir/subscriptions","organizations_url":"https://api.github.com/users/kenoir/orgs","repos_url":"https://api.github.com/users/kenoir/repos","events_url":"https://api.github.com/users/kenoir/events{/privacy}","received_events_url":"https://api.github.com/users/kenoir/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/wellcomecollection/platform/issues/6843/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/wellcomecollection/platform/issues/6843/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}