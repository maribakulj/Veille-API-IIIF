    "value" : {
      "none" : [ "Origin and date: According to Morrison & 2010a." ]
    }
  }, {
    "label" : {
      "none" : [ "Description" ]
    },
    "value" : {
      "none" : [ "The Leiden codex is the first of a four-volume set. The second codex of this set also survived: Paris, Arsenal, Ms. 5080. The set represents one of the first copies of the completed translation, owned by the future king of France, John II the Good. On this manuscript see especially Chavannes-Mazel 1988b." ]
    }
  }, {
    "label" : {
      "none" : [ "Description" ]
    },
    "value" : {
      "none" : [ "Illumination: Miniatures executed by Papeleu Master and assistants, Cambrai Master; Mahiet. A complete listing of the miniatures in Byvanck 1931." ]
    }
  }, {
    "label" : {
      "none" : [ "Description" ]
    },
    "value" : {
      "none" : [ "Textual: French translation of Vincent of Beauvais's Speculum historiale by Jean de Vignay." ]
    }
