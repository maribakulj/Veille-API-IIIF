<script>
        
          function checkCookiesAccepted() {
              var userConfirmedCookieUsage = false;
              var x = document.cookie;

              if (x != undefined) {
                  userConfirmedCookieUsage = x.indexOf("accept-cookies=yes") != -1;

                  if (userConfirmedCookieUsage == false) {
                      if(window.location.href.indexOf("privacy.xml") == -1){
                        $('#get-consent').modal();
                      }
                  }
              }
          }

          function setAcceptCookiesCookie() {
              document.cookie = "accept-cookies=yes; expires=2222; path=/";
          }

          function removeConsentGivenToTracking() {

          }
      
      </script><script>
        checkCookiesAccepted();
