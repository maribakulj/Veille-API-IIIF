{"@context":"http://iiif.io/api/presentation/2/context.json","@id":"https://iiif.library.utoronto.ca/presentation/v2/collections/paleography:root","@type":"sc:Collection","label":"French Renaissance Paleography","thumbnail":{"@id":"https://static.scholarsportal.info/collectionsuoft/resources/paleography:root/tn/TN.jpg","@type":"dctypes:Image","format":"image/jpeg","height":120,"width":80},"attribution":"For rights and reproduction information please contact digitalinitiatives@library.utoronto.ca","metadata":[{"label":"Title","value":[{"@value":"French Renaissance Paleography","@language":"none"}]},{"label":"Type of Resource","value":[{"@value":"collection","@language":"none"}]},{"label":"Summary","value":[{"@value":"Paleography is the history and study of handwriting. Old scripts can be very beautiful, but sometimes difficult to read. The French Paleography collaborative project presents over 100 carefully selected French manuscripts written between 1300 and 1700, with tools for deciphering them and learning about their social, cultural, and institutional settings.|Visit the project's website at https://french.newberry.t-pen.org/","@language":"none"}]},{"label":"Catalog Record","value":[{"@value":"http://go.utlib.ca/cat/11624538","@language":"none"}]}],"collections":[{"@id":"https://iiif.library.utoronto.ca/presentation/v2/collections/paleography:calligraphybooks","@type":"sc:Collection","label":"Calligraphy Books"},{"@id":"https://iiif.library.utoronto.ca/presentation/v2/collections/paleography:historicalmaps","@type":"sc:Collection","label":"Historical Maps"},{"@id":"https://iiif.library.utoronto.ca/presentation/v2/collections/paleography:manuscripts","@type":"sc:Collection","label":"Manuscripts"}],"manifests":[]}