                "dc.description" : [ {
                  "value" : "Inserto \"Supernight\" di \"Aria di mezzanotte\": Enzo Tortora presenta Nadia, la domatrice di tigri in topless. Per gentile concessione di Antenna 3 (Gruppo Mediapason)",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description.abstract" : [ {
                  "value" : "min. 00:00-1:20: Enzo Tortora chiama in scena la domatrice di tigri Nadia, \"la sola donna al mondo che fa questo numero in una piccola gabbia\"; min. 1:20-1:44: Enzo Tortora evidenzia il primato dell'esibizione, che poche emittenti hanno potuto trasmettere; min. 1:44-8:09: Sulle note de \"La pantera rosa\" di Henry Mancini fa il suo ingresso la tigre indiana, che completa il numero con la domatrice a seno scoperto, fino al bacio finale con il conduttore",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
