                "dc.description" : [ {
                  "value" : "Amorevoli schermaglie tra Ettore Andenna e Diana Scapolan, ex Miss Europa e Miss Cinema Italia nel 1973; il conduttore dichiara il suo sentimento verso la valletta (già sua moglie), che arricchisce lo scambio di battute con alcuni dettagli sulla vita privata dei due protagonisti. Per gentile concessione di Antenna 3 (Gruppo Mediapason)",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
