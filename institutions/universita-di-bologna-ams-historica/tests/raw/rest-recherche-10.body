                } ],
                "dc.description" : [ {
                  "value" : "Il gioco del bingo coinvolge il pubblico in studio, che può vincere una selezione di articoli messi in palio dagli sponsor del programma; Renzo Villa presenta poi Walter Chiari, che annuncia la firma di un contratto annuale con l'emittente. Per gentile concessione di Antenna 3 (Gruppo Mediapason)",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description.abstract" : [ {
                  "value" : "min. 00:00-2:09: Villa è tra il pubblico in studio, che prende parte al tombolone, con tanti omaggi degli sponsor; min. 2:09-2:44: Villa presenta Walter Chiari, che fa il suo ingresso in studio; 2:44.4:08: Breve scambio di battute tra il conduttore e Chiari, che anticipa un coinvolgimento costante nella programmazione dell'emittente dalla stagione successiva",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
