                "dc.description" : [ {
                  "value" : "Esibizione di Nilla Pizzi, già coinvolta nel programma \"L'allegro giovedì\", e breve scambio di battute con il conduttore, che evidenzia la presenza straordinaria della cantante, che per partecipare alla trasmissione ha posticipato un impegno in Rai. Per gentile concessione di Antenna 3 (Gruppo Mediapason)",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description.abstract" : [ {
                  "value" : "min. 00:00-3:20: Nilla Pizzi si esibisce ne \"Un giorno all'italiana\"; min. 3:20-4:55: Renzo Villa si intrattiene con la cantante, spiegando i motivi dietro alla sua assenza nel promo del programma",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
