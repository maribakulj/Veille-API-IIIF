                "dc.date.issued" : [ {
                  "value" : "1980-11-13",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description" : [ {
                  "value" : "L'onorevole Aldo Aniasi (PSI) si sottopone all'\"intervista contropelo\" di \"Aria di Mezzanotte\": un barbiere rade la barba dell'ospite mentre Enzo Tortora gli rivolge alcune domande pungenti, indagando sul suo rapporto con il partito e con le altre forze politiche; in un intermezzo interviene anche Cesare Musatti, tra i principali esponenti italiani della psicanalisi. Anche questo \"Contropelo\" è offerto da Braun, che può così promuovere i propri rasoi elettrici . Per gentile concessione di Antenna 3 (Gruppo Mediapason)",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description.abstract" : [ {
                  "value" : "min. 00:00-1:49: Enzo Tortora apre l'intervista ad Aldo Aniasi rivolgendogli alcune domande sul suo rapporto con il Partito Socialista e con Bettino Craxi; min. 1:49-2:40: Il presentatore chiede all'intervistato di esplicitare meglio il suo rapporto con la Democrazia Cristiana; min. 2:40-3:33: Interviene lo psicanalista Cesare Musatti, che si dichiara socialista; min. 3:33-6:11: Tortora insiste con Aniasi sulla possibile caduta del governo e sullo scandalo delle tangenti, sullo sfondo di terrorismo e inflazione",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.format.extent" : [ {
                  "value" : "6:11 min.",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
