                "dc.description" : [ {
                  "value" : "Esibizione di Rita Pavone e breve scambio di battute con il conduttore, che ne sottolinea la versatilità artistica, prima di lanciare il secondo brano (\"La valigia\") cantato davanti al pubblico dello Studio 1 di Legnano. Per gentile concessione di Antenna 3 (Gruppo Mediapason)",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
                "dc.description.abstract" : [ {
                  "value" : "min. 00:00-1:00: Rita Pavone termina l'esibizione di \"Africa\"; min. 1:00-3:03: Renzo Villa si intrattiene con la cantante sottoponendola al gioco della torre; viene poi spiegato il significato della canzone appena proposta, a cui segue \"La valigia\", brano dedicato all'universo femminile",
                  "language" : null,
                  "authority" : null,
                  "confidence" : -1,
                  "place" : 0
                } ],
